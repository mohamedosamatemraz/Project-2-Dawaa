    {
      "parameters": {
        "jsCode": "// Add the expired quantities back per SKU (several lines can hold the same medicine).\nconst now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm');\nconst back = {};\nfor (const r of $('Read Reservations').all().map(i => i.json)) if (r.res_id && r.expires_at && r.expires_at < now) back[r.sku] = (back[r.sku] || 0) + Number(r.qty);\nconst cat = Object.fromEntries($('Read Catalog').all().map(i => [i.json.sku, i.json]));\nreturn Object.entries(back).filter(([s]) => cat[s]).map(([sku, q]) => ({ json: { sku, stock: Number(cat[sku].stock) + q } }));"
      },
